# Pockito Environment Variables
# If left empty, Pockito automatically runs in Offline / Local Demo mode with rich seeded data!

# Supabase Project URL (Optional for local testing, required for cloud production)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (Safe for client browsers, NEVER use service_role key here)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
